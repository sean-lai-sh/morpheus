# Morpheus Discord intelligence bot — environment variables
#
# This file is committed for documentation only. At runtime, secrets are
# injected by Doppler on the Mac Mini:    doppler run -- bun src/index.ts <cmd>
# Do NOT create a real .env in this repo. .gitignore covers it as a safety net.
# Hosting: docs/hosting.md  (Mac Mini. Not AWS. Not Grok Bot's box. Not Cursor VMs.)

# --- Mini only: official Discord bot (Developer Portal -> Bot tab) ---
DISCORD_BOT_TOKEN=                 # preferred; never commit
DISCORD_TOKEN=                     # legacy alias for DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=                  # numeric guild snowflake

# --- Mini only: outbound dispatch to Grok Bot (consumer, not the host) ---
GROK_BOT_WEBHOOK_URL=              # https URL; Mini POSTs { job, snippets }

# --- Grok Bot secret store: Discord incoming webhooks (operational feed) ---
# Create in channel settings → Integrations → Webhooks. Never commit real URLs.
# See docs/discord-webhooks.md
DISCORD_WEBHOOK_SPONSORS=          # #sponsors inbound+outbound
DISCORD_WEBHOOK_OPPORTUNITIES=     # #opportunities
DISCORD_WEBHOOK_SPEAKERS=          # #speakers
DISCORD_WEBHOOK_INBOX=             # proposed #inbox for unmatched routing

# --- Nia (apigcp.trynia.ai) --- Mini/Doppler until deleted; not Grok Bot ---
NIA_API_KEY=
NIA_BASE_URL=https://apigcp.trynia.ai/v2
NIA_DISCORD_SOURCE_ID=             # populated by `bun run register-nia` after first setup

# --- Mini localhost /v1 only (not Grok internet; namespace from which token matched) ---
MORPHEUS_API_TOKEN_GENERAL=
MORPHEUS_API_TOKEN_LEADERSHIP=

# --- Mini: who may enqueue jobs (fail closed if empty in production) ---
JOB_TRIGGER_ROLE_IDS=              # comma-separated Discord role snowflakes
JOB_MAX_OUTSTANDING_PER_AUTHOR=2
JOB_MAX_PER_AUTHOR_PER_HOUR=5

# --- Grok Bot (optional): GitHub implementation issues only ---
GITHUB_ISSUE_REPO=                 # e.g. sean-lai-sh/morpheus; refuse others
OPEN_GITHUB_ISSUES_FROM_LEADERSHIP=false
GITHUB_ISSUE_CREATION=approval_required

# --- Runtime tunables ---
LOG_LEVEL=info                     # pino level: trace|debug|info|warn|error|fatal
HEALTH_PORT=8080                   # /health on Mini localhost
RETENTION_MONTHS=4                  # blank = no rotation (default)
NODE_ENV=development               # set to "production" on the Mini
